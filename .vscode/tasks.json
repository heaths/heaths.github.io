{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve",
      "type": "shell",
      "command": "npm run dev -- --buildDrafts",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "npm test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "post",
      "type": "shell",
      "command": "hugo new content posts/${input:slug}/index.md",
      "problemMatcher": [],
      "presentation": {
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "slug",
      "type": "promptString",
      "description": "Post slug (e.g., my-new-post)"
    }
  ]
}
